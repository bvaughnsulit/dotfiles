{
    "env": {
        "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1"
    },
    "includeCoAuthoredBy": false,
    "permissions": {
        "allow": [
            "Bash(find:*)",
            "Bash(gh pr view *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git show *)",
            "Bash(git status *)",
            "Bash(grep:*)",
            "Bash(ls:*)",
            "Bash(npm run test *)",
            "Bash(npm test *)",
            "Bash(npm run check*)",
            "Bash(npm run format *)",
            "Bash(tail:*)",
            "WebFetch(domain:github.com)",
            "WebSearch"
        ],
        "deny": [
            "Bash(npx:*)",
            "Bash(yarn:*)"
        ]
    },
    "model": "opus[1m]",
    "hooks": {
        "Notification": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$DOTFILES_DIR/claude/hooks/notification_hook.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "[ -n \"$NVIM\" ] && (nvim --server \"$NVIM\" --remote-send '<cmd>checktime<cr>')"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node $DOTFILES_DIR/claude/hooks/on_pre_tool_use.ts"
                    }
                ]
            }
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "$DOTFILES_DIR/claude/statusline.sh",
        "padding": 0
    },
    "enabledPlugins": {
        "claude-md-management@claude-plugins-official": false,
        "commit-commands@claude-plugins-official": true,
        "feature-dev@claude-plugins-official": true,
        "lua-lsp@claude-plugins-official": true,
        "pr-review-toolkit@claude-plugins-official": true,
        "pyright-lsp@claude-plugins-official": true,
        "ralph-loop@claude-plugins-official": false,
        "security-guidance@claude-plugins-official": true,
        "superpowers@claude-plugins-official": true,
        "typescript-lsp@claude-plugins-official": true,
        "frontend-design@claude-plugins-official": false,
        "claude-code-setup@claude-plugins-official": false,
        "code-review@claude-plugins-official": true,
        "code-simplifier@claude-plugins-official": true,
        "skill-creator@claude-plugins-official": false,
        "hookify@claude-plugins-official": false,
        "datadog@claude-plugins-official": false
    },
    "effortLevel": "high",
    "promptSuggestionEnabled": false,
    "tui": "default",
    "theme": "light",
    "preferredNotifChannel": "terminal_bell"
}
