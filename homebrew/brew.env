# Symlinked to ~/.homebrew/brew.env by scripts/setup.sh.
# Format: one KEY=value per line; no quotes, no $VAR expansion.
# A leading ~ works in HOMEBREW_BUNDLE_FILE because brew expands it when resolving the path.

# Brewfile is symlinked alongside this file by scripts/setup.sh
HOMEBREW_BUNDLE_FILE=~/.homebrew/Brewfile

# brew bundle dump: only track taps/formulae/casks; skip other package managers
HOMEBREW_BUNDLE_DUMP_NO_CARGO=1
HOMEBREW_BUNDLE_DUMP_NO_FLATPAK=1
HOMEBREW_BUNDLE_DUMP_NO_GO=1
HOMEBREW_BUNDLE_DUMP_NO_KREW=1
HOMEBREW_BUNDLE_DUMP_NO_MAS=1
HOMEBREW_BUNDLE_DUMP_NO_NPM=1
HOMEBREW_BUNDLE_DUMP_NO_UV=1
HOMEBREW_BUNDLE_DUMP_NO_VSCODE=1
HOMEBREW_BUNDLE_DUMP_NO_WINGET=1
HOMEBREW_BUNDLE_NO_DESCRIBE=1
